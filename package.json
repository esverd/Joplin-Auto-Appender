{
  "name": "joplin-plugin-auto-appender",
  "version": "0.1.0",
  "description": "Send selected text to a configurable Joplin destination note.",
  "author": "Sverd Industries",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --external:api && esbuild src/cm-bridge.ts --bundle --outfile=dist/cm-bridge.js --platform=browser",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-tests/tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4"
  }
}
